{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "powertoys": {
      "command": ".venv\\Scripts\\python.exe",
      "args": ["powertoys_mcp.py"],
      "cwd": "."
    },
    "officecli": {
      "command": "tools\\officecli\\officecli.exe",
      "args": ["mcp"],
      "cwd": ".",
      "env": {
        "OFFICECLI_SKIP_UPDATE": "1",
        "OFFICECLI_NO_AUTO_RESIDENT": "1"
      },
      "deskorb": {
        "description": "Create, read, modify, validate, and render Word, Excel, and PowerPoint files",
        "keywords": [
          "officecli",
          "docx",
          "xlsx",
          "pptx",
          "Word",
          "Excel",
          "PowerPoint",
          "\u6587\u6863\u751f\u6210",
          "\u6f14\u793a\u6587\u7a3f",
          "\u5de5\u4f5c\u7c3f"
        ]
      }
    },
    "documents": {
      "command": ".venv\\Scripts\\python.exe",
      "args": ["document_mcp.py"],
      "cwd": ".",
      "env": {
        "DESKORB_AGENT_DOCUMENT_ROOTS": "."
      },
      "deskorb": {
        "capability": "documents",
        "keywords": ["文档", "PDF", "Word", "Excel", "PPT", "document", "pdf"],
        "description": "Read one explicitly scoped local document as bounded evidence.",
        "allowed_tools": ["document_status", "document_inspect", "document_convert_file"],
        "read_only_tools": ["document_status", "document_inspect", "document_convert_file"],
        "allowed_roots": ["."]
      }
    },
    "public_fetch": {
      "command": ".venv\\Scripts\\python.exe",
      "args": ["public_fetch_mcp.py"],
      "cwd": ".",
      "env": {
        "DESKORB_AGENT_PUBLIC_ALLOWED_DOMAINS": "bing.com,fastapi.tiangolo.com,taobao.com,tmall.com"
      },
      "deskorb": {
        "capability": "public_fetch",
        "keywords": ["公开网页", "公网只读", "Fetch", "public web", "research"],
        "description": "Fetch one allowlisted public HTTPS page as untrusted read-only text.",
        "allowed_tools": ["public_fetch_status", "public_fetch"],
        "read_only_tools": ["public_fetch_status", "public_fetch"],
        "allowed_domains": ["bing.com", "fastapi.tiangolo.com", "taobao.com", "tmall.com"]
      }
    }
  }
}
