# Copy these values to the parent workspace's .env file, or configure them in
# Gear → Connection settings. Never commit a real key.
api-key: your-api-key
url: https://provider.example/v1
model_name: gpt-5.6-terra
# Optional network tuning. Retries only cover transient provider failures;
# after the threshold the UI reports a temporary circuit-open state.
# DESKORB_AGENT_API_TIMEOUT=180
# DESKORB_AGENT_API_REQUEST_RETRIES=2
# DESKORB_AGENT_API_RETRY_BACKOFF_SECONDS=2
# DESKORB_AGENT_API_CIRCUIT_FAILURE_THRESHOLD=3
# DESKORB_AGENT_API_CIRCUIT_COOLDOWN_SECONDS=30
# DESKORB_AGENT_API_PROXY=http://127.0.0.1:12000
# Optional JSON catalogs. Do not put API keys in either value.
# Fallback targets are probed only when their provider-specific key is present
# (DEEPSEEK_API_KEY, QWEN_API_KEY, or DASHSCOPE_API_KEY); the primary generic
# api-key is never sent to a different vendor by the acceptance probe.
# Connection settings stores these keys in separate Windows Credential Manager
# entries (DeepSeekAPIKey/QwenAPIKey); the variables below are optional CI or
# headless overrides and should never be committed with real values.
# DESKORB_AGENT_MODEL_FALLBACKS: [{"id":"deepseek","provider":"deepseek","model":"deepseek-chat","base_url":"https://api.deepseek.com","privacy_level":"third_party"},{"id":"qwen","provider":"qwen","model":"qwen-plus","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","privacy_level":"third_party"}]
# DESKORB_AGENT_MODEL_CAPABILITIES: [{"provider":"deepseek","model":"deepseek-chat","supports_tools":true,"supports_vision":false,"privacy_level":"third_party"}]
