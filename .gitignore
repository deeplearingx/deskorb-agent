# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.worktrees/
.claude/
.pytest_cache/
.env
*.env
.env.*
!.env.example
!*.env.example

# Project-local provider template and generated Office outputs
/volcengine.env.example
/*.doc
/*.docx
/*.ppt
/*.pptx
/~$*.doc*
/~$*.ppt*

# Machine-specific launchers / shortcuts (recreate locally)
*.lnk

# Logs & scratch
*.log
_*.log
_*.py
_*.png
app-server-schema/

# Runtime screenshots (the app writes these to %TEMP%, but ignore here too)
claude_overlay_shots/
deskorb_agent_shots/
.playwright-mcp/
.deskorb-agent/
.deskorb-playwright-*/
.mcp-probe-*/
mcp-profile-*/
artifacts/

# OfficeCLI self-contained release output (package separately)
/tools/officecli/

# Local launch / marketing / progress notes (keep out of the public repo)
LAUNCH_KIT.md
PROGRESS.md
CODEX_CRASH_AUDIT.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Inbound contribution archives (kept locally as provenance only - may carry a
# contributor's private email / unsanitized patch; never commit to the public repo)
*-submission.zip
# Optional in-repo meeting output when DESKORB_AGENT_MEETING_DIR points here.
/meeting-recordings/

# Bundled WhisperX runtime state (source is committed; generated environments/outputs are not)
/whisperX-main/.venv/
/whisperX-main/outputs/
/whisperX-main/.cache/
